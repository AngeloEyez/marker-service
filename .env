# ==========================================
# Marker PDF 微服務環境設定檔
# ==========================================

# 服務監聽設定
HOST=0.0.0.0
PORT=8090

# GPU 裝置設定 (0: RTX 3050, 1: T1000)
NVIDIA_VISIBLE_DEVICES=all
CUDA_VISIBLE_DEVICES=0,1

# Surya 本地推論引擎設定 (使用 CUDA 加速 llama-server)
SURYA_INFERENCE_BACKEND=llamacpp
LLAMA_CPP_NGL=99
SURYA_INFERENCE_PARALLEL=8
SURYA_INFERENCE_KEEP_ALIVE=true

# 遠端 vLLM / OpenAI 相容服務設定 (用於 --use_llm 語意及格式校正)
OPENAI_BASE_URL=http://192.168.1.5:8000/v1
OPENAI_MODEL=Qwen3.8-27B
OPENAI_API_KEY=none
LLM_TIMEOUT=180
LLM_MAX_RETRIES=3
# VLM / LLM 思考抑制控制 (可選: low, none, medium; 或直接將 LLM_ENABLE_THINKING 設為 false 關閉思考以大幅加速)
LLM_REASONING_EFFORT=low
LLM_ENABLE_THINKING=false

# 預設轉換參數
DEFAULT_MODE=balanced
DEFAULT_OUTPUT_FORMAT=markdown
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIRECTORY=/tmp/marker_uploads
# 預設區塊校正與浮水印去除 Prompt (留空則使用程式內建最佳化英文清理提示詞)
DEFAULT_BLOCK_CORRECTION_PROMPT=

# 併發排程與自動清理機制 (防止 GPU 顯存 OOM 與磁碟膨脹)
MAX_CONCURRENT_CONVERSIONS=1
MAX_COMPLETED_JOBS_HISTORY=500
JOB_RETENTION_SECONDS=86400
FILE_RETENTION_SECONDS=86400
CLEANUP_INTERVAL_SECONDS=86400

# 快取路徑 (映射至容器內部掛載點)
HF_HOME=/data/cache/huggingface
TORCH_HOME=/data/cache/torch
DATALAB_CACHE_DIR=/data/cache/datalab
